{
  "name": "dsh-text-manager",
  "version": "1.6.2",
  "description": "Two independent modules for DSH conversations: translate English reasoning and interleaved narration into Chinese, and restyle the text inside the conversation · 文本管理器：翻译模块（思考链 + 零散文字）+ 对话内文字样式模块，两者各有独立开关",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs && node test/settings.test.mjs && node test/style.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "translation",
    "reasoning",
    "theme",
    "typography"
  ],
  "license": "MIT"
}
